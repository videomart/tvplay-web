# =============================================================================
# TVPlay Web — variáveis de ambiente
# =============================================================================
# Para DOCKER: NÃO é necessário criar .env — o docker-compose.yml já contém
# todos os valores padrão hardcoded.
#
# Para DESENVOLVIMENTO LOCAL (sem Docker): copie este arquivo para .env e
# ajuste os valores conforme seu ambiente.
#   cp .env.example .env
# =============================================================================

NODE_ENV=development
PORT=3001

# Database (local: postgres rodando na porta padrão)
DATABASE_URL=postgresql://tvplay:tvplay123@localhost:5432/tvplay

# Redis (local)
REDIS_URL=redis://localhost:6379

# JWT — TROQUE EM PRODUÇÃO
JWT_SECRET=change-this-to-a-very-long-random-secret-string
# 30d: sala de operação fica com a tela aberta por horas/dias sem interação;
# expiração curta derrubava a sessão sem aviso (logout forçado + redirect).
JWT_EXPIRES_IN=30d

# MinIO / Storage (local: minio rodando na porta padrão)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_USE_SSL=false
MINIO_BUCKET=tvplay-media

# FFmpeg — caminho do executável (deve estar no PATH)
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe

# Paths de saída de mídia (HLS, transcodificação)
HLS_OUTPUT_PATH=./storage/hls
TRANSCODE_OUTPUT_PATH=./storage/transcoded
