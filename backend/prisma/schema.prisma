generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserLevel {
  ADMIN
  OPERATOR
  VIEWER
}

enum ClipModality {
  BK // Bloco de Programa
  AR // Arquivo/Reprisa
  PT // Vinheta Promocional
  VH // VT Humorístico
  CP // Comercial/Publicidade
  CA // Campanha
  LV // Ao Vivo (Live)
  ID // ID de Canal
  MT // Material Teaser
}

enum PlayoutStatus {
  IDLE
  PLAYING
  PAUSED
  STOPPED
  ERROR
}

enum IngestStatus {
  PENDING
  PROCESSING
  READY
  ERROR
}

enum FallbackType {
  BLACK
  COLORBARS
  INPUT_SOURCE
}

enum ClipSourceType {
  FILE
  URL
}

enum StreamOutputType {
  RTMP
  HLS_PUSH
  SDI
  SRT
  UDP
  RTP
  LOCAL_DEVICE
}

enum GraphicElementType {
  LOGO         // imagem/logo overlay
  CLOCK        // relógio local via drawtext
  TEXT         // texto estático via drawtext
  TICKER       // texto scrolling horizontal
  LOWER_THIRD  // caixa com título + subtítulo
}

enum GraphicPosition {
  TL          // top-left
  TC          // top-center
  TR          // top-right
  ML          // middle-left
  MC          // middle-center
  MR          // middle-right
  BL          // bottom-left
  BC          // bottom-center
  BR          // bottom-right
  BAR_TOP     // barra horizontal topo (largura total)
  BAR_BOTTOM  // barra horizontal base (largura total)
}

enum InputSourceType {
  IP
  YOUTUBE
  SRT
  SDI
  USB          // legado
  LOCAL_DEVICE // legado
  CLIP
  WEBCAM       // webcam do browser via SRT local
}

// ─── Usuários ────────────────────────────────────────────────────────────────

model User {
  id        String    @id @default(cuid())
  name      String
  username  String    @unique
  password  String
  level     UserLevel @default(OPERATOR)
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  logs Log[]

  @@map("users")
}

// ─── Canais ───────────────────────────────────────────────────────────────────

model Channel {
  id          String        @id @default(cuid())
  name        String
  description String?
  number      Int           @unique
  logoUrl     String?
  active      Boolean       @default(true)
  status      PlayoutStatus @default(IDLE)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  fallbackType     FallbackType @default(BLACK)
  fallbackSourceId String?
  fallbackSource   InputSource? @relation("ChannelFallback", fields: [fallbackSourceId], references: [id])

  activePlaylistId String?
  playlistIndex    Int     @default(0)

  graphicTemplateId String?
  graphicTemplate   GraphicTemplate? @relation(fields: [graphicTemplateId], references: [id])

  playlists     Playlist[]
  streamOutputs StreamOutput[]
  inputSources  InputSource[]  @relation("ChannelSources")

  @@map("channels")
}

// ─── Clientes / Anunciantes ───────────────────────────────────────────────────

model Client {
  id        String   @id @default(cuid())
  name      String
  document  String?
  contact   String?
  email     String?
  phone     String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clips Clip[]

  @@map("clients")
}

// ─── Tipos de Clipe ───────────────────────────────────────────────────────────

model ClipType {
  id            String   @id @default(cuid())
  name          String
  code          String   @unique
  fontColor     String   @default("#FFFFFF")
  fontBackColor String   @default("#1A1A2E")
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  clips Clip[]

  @@map("clip_types")
}

// ─── Arquivos de Mídia ────────────────────────────────────────────────────────

model MediaFile {
  id           String      @id @default(cuid())
  originalName String
  storagePath  String
  hlsPath      String?
  mimeType     String
  sizeBytes    BigInt
  duration     Float?
  width        Int?
  height       Int?
  fps          Float?
  bitrate      Int?
  videoCodec   String?
  audioCodec   String?
  thumbnail    String?
  ingestStatus IngestStatus @default(PENDING)
  errorMsg     String?
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt

  clips Clip[]

  @@map("media_files")
}

// ─── Clipes ───────────────────────────────────────────────────────────────────

model Clip {
  id         String          @id @default(cuid())
  code       String          @unique
  title      String
  modality   ClipModality    @default(CP)
  sourceType ClipSourceType  @default(FILE)
  sourceUrl  String?         // URL YouTube/Twitch para sourceType=URL
  cueIn      Float           @default(0)
  cueOut     Float?
  duration   Float?
  validUntil DateTime?
  isLive     Boolean         @default(false)
  active     Boolean         @default(true)
  notes      String?
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt

  clientId String?
  client   Client?   @relation(fields: [clientId], references: [id])

  typeId String?
  type   ClipType? @relation(fields: [typeId], references: [id])

  mediaId String?
  media   MediaFile? @relation(fields: [mediaId], references: [id])

  graphicId String?
  graphic   Graphic? @relation(fields: [graphicId], references: [id])

  playlistItems PlaylistItem[]
  inputSources  InputSource[]

  @@map("clips")
}

// ─── Playlists ────────────────────────────────────────────────────────────────

model Playlist {
  id    String   @id @default(cuid())
  date  DateTime @db.Date
  name  String
  isAutoSave  Boolean  @default(false)
  locked      Boolean  @default(false)
  loop        Boolean  @default(false)
  autoStart   Boolean  @default(false)
  startTime   String?
  notes       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  channelId String?
  channel   Channel? @relation(fields: [channelId], references: [id])

  graphicId String?
  graphic   Graphic? @relation(fields: [graphicId], references: [id])

  items PlaylistItem[]
  logs  Log[]

  @@unique([channelId, date, name])
  @@map("playlists")
}

// ─── Itens da Playlist ────────────────────────────────────────────────────────

model PlaylistItem {
  id           String    @id @default(cuid())
  order        Int
  breakNum     Int       @default(1)
  blockOrder   Int       @default(1)
  scheduledAt  DateTime?
  overrideCueIn  Float?
  overrideCueOut Float?
  loop         Boolean   @default(false)
  maxDuration  Int?
  isBreak      Boolean   @default(false)
  createdAt    DateTime  @default(now())

  playlistId String
  playlist   Playlist @relation(fields: [playlistId], references: [id], onDelete: Cascade)

  clipId String?
  clip   Clip?   @relation(fields: [clipId], references: [id])

  @@index([playlistId, order])
  @@map("playlist_items")
}

// ─── Gráficos de Sobreposição ─────────────────────────────────────────────────

model Graphic {
  id           String   @id @default(cuid())
  name         String
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // Sistema novo: template + valores por elemento
  templateId    String?
  template      GraphicTemplate? @relation(fields: [templateId], references: [id])
  elementValues Json?   // { "elemId": { imageUrl?, text?, subtitle?, active?, fontColor?, ... } }

  // Sistema legado (backwards compat — usado quando templateId é null)
  logoUrl      String?
  logoPosition String?
  showClock    Boolean  @default(false)
  lowerText    String?

  streamOutputs StreamOutput[]
  clips         Clip[]
  playlists     Playlist[]
  inputSources  InputSource[]

  @@map("graphics")
}

// ─── Templates Gráficos (evolução do sistema de Graphic) ─────────────────────

model GraphicTemplate {
  id          String   @id @default(cuid())
  name        String
  description String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  elements    GraphicElement[]
  channels    Channel[]
  graphics    Graphic[]

  @@map("graphic_templates")
}

model GraphicElement {
  id         String             @id @default(cuid())
  templateId String
  template   GraphicTemplate    @relation(fields: [templateId], references: [id], onDelete: Cascade)

  type       GraphicElementType
  position   GraphicPosition

  // Conteúdo
  imageUrl   String?   // LOGO: URL da imagem
  text       String?   // TEXT / TICKER / LOWER_THIRD (título)
  subtitle   String?   // LOWER_THIRD: segunda linha

  // Estilo
  fontColor  String    @default("#FFFFFF")
  bgColor    String?   // null = sem fundo
  fontSize   Int       @default(32)
  opacity    Float     @default(1.0)
  bold       Boolean   @default(false)

  // Layout
  width      Int?      // px — LOGO/BOX
  height     Int?      // px — LOGO/BOX
  padding    Int       @default(10)

  // Ticker
  tickerSpeed Float    @default(5)  // pixels/segundo (independente do framerate)
  tickerLoop  Boolean  @default(true) // false = exibe uma vez e para
  rssUrl      String?              // URL de feed RSS (substitui text quando preenchido)

  active     Boolean   @default(true)
  order      Int       @default(0)

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("graphic_elements")
}

// ─── Saídas de Streaming ─────────────────────────────────────────────────────

model StreamOutput {
  id          String           @id @default(cuid())
  name        String
  description String?
  type        StreamOutputType
  url         String?
  streamKey   String?
  device          String?
  deviceOs        String?   // WINDOWS | LINUX (para LOCAL_DEVICE)
  deviceDriver    String?   // DSHOW | V4L2 | DECKLINK (para LOCAL_DEVICE)
  deviceName      String?   // nome/caminho do dispositivo no host (para LOCAL_DEVICE)
  videoResolution String?
  videoBitrate    Int?
  audioBitrate    Int?
  active      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  channelId String
  channel   Channel @relation(fields: [channelId], references: [id])

  graphicId String?
  graphic   Graphic? @relation(fields: [graphicId], references: [id])

  @@map("stream_outputs")
}

// ─── Fontes de Entrada ────────────────────────────────────────────────────────

model InputSource {
  id           String          @id @default(cuid())
  name         String
  type         InputSourceType
  url          String?
  device       String?
  deviceOs     String?   // WINDOWS | LINUX (para LOCAL_DEVICE)
  deviceDriver String?   // DSHOW | V4L2 | DECKLINK (para LOCAL_DEVICE)
  deviceName   String?   // nome/caminho do dispositivo no host (para LOCAL_DEVICE)
  serverIp     String?   // IP do servidor TVPlay para o agente LOCAL_DEVICE enviar SRT
  inputNumber  Int?            // índice único por canal — usado nos botões do Switcher
  active       Boolean         @default(true)
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt

  channelId String?
  channel   Channel? @relation("ChannelSources", fields: [channelId], references: [id])

  clipId String?
  clip   Clip? @relation(fields: [clipId], references: [id])

  graphicId String?
  graphic   Graphic? @relation(fields: [graphicId], references: [id])

  fallbackForChannels Channel[] @relation("ChannelFallback")

  @@map("input_sources")
}

// ─── Configurações do Sistema ────────────────────────────────────────────────

model SystemSettings {
  id          String  @id @default("singleton")
  appTitle    String  @default("TVPlay Web")
  companyName String  @default("TVPlay")
  logoUrl     String?
  email       String?

  // Visibilidade default dos blocos no Playout
  defaultMonitorOpen  Boolean @default(true)
  defaultFallbackOpen Boolean @default(true)
  defaultOutputsOpen  Boolean @default(true)
  defaultPlaylistOpen Boolean @default(true)

  // Fuso horário do relógio no gráfico de stream (offset UTC em horas inteiras)
  clockOffsetHours Int @default(0)

  // Duração padrão do item BREAK ao inserir (em segundos)
  defaultBreakDuration Int @default(300)

  // Duração padrão de slides (imagens) ao inserir na playlist (em segundos)
  defaultSlideDuration Int @default(15)

  // Duração máxima padrão de clipes URL (YouTube/SRT) ao inserir na playlist (em segundos, 0 = sem limite)
  defaultUrlDuration   Int @default(0)

  updatedAt DateTime @updatedAt

  @@map("system_settings")
}

// ─── Log de Exibição ──────────────────────────────────────────────────────────

model Log {
  id          String    @id @default(cuid())
  program     String
  title       String
  duration    Float
  exhibited   Boolean   @default(false)
  startedAt   DateTime?
  finishedAt  DateTime?
  scheduledAt DateTime?
  client      String?
  notes       String?
  createdAt   DateTime  @default(now())

  userId String?
  user   User?   @relation(fields: [userId], references: [id])

  playlistId String?
  playlist   Playlist? @relation(fields: [playlistId], references: [id], onDelete: SetNull)

  @@map("logs")
}
